# Copy to .env.local and fill in. The two NEXT_PUBLIC_SUPABASE_* values are the
# public client credentials (Project Settings -> API). They are safe in a browser
# bundle; row level security protects the data. Never commit a service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to true to render the demo credential cards on /login and /register.
# Those accounts are real and the admin one reaches /admin, so leave this off
# (or unset) for any deployment the public can reach.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=false
