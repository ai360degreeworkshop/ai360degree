<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono%3Awght%40700&family=IBM+Plex+Sans%3Awght%40100..700&family=Space+Grotesk%3Awght%40300..700&display=swap"
      rel="stylesheet"
    />

    <style>
      *, ::before, ::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        display: flex;
        justify-content: center;
        overflow-x: hidden;
        background-color: #f7fbf6;
      }

      [data-pencil-name="AI 360° — Mobile Homepage App UI"] {
        max-width: 100vw;
        padding-bottom: 78px;
      }

      [data-pencil-name="Mobile WhatsApp Action"] {
        display: none !important;
      }

      [data-pencil-name="Persistent Mobile App Bottom Navigation"] {
        position: fixed !important;
        inset: auto 12px 12px 12px !important;
        width: auto !important;
        max-width: 366px;
        margin: 0 auto;
        z-index: 50 !important;
      }
    </style>
  </head>
